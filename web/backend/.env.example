# Kopiere diese Datei nach ".env" und trage deinen Key ein.
# Key erstellen: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_PROVIDER=gemini

# Zufälliger langer Wert, z. B.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Einladungscode für die Registrierung. Leer = Registrierung geschlossen.
REGISTRATION_CODE=
# Adresse(n) des Frontends für CORS, durch Komma getrennt (nur im Betrieb nötig), z. B. https://hub.deine-domain.de
CORS_ORIGINS=
# Optional: Supabase statt lokaler SQLite-Datei
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional: Ausweichmodelle (Komma getrennt), falls das Hauptmodell überlastet ist
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
